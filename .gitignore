# Claude Code (anchored to repo root so nested paths are unaffected)
/.claude/
/CLAUDE.md

# Docs: only the published files are tracked. "docs/*" (not "docs/") ignores the
# directory's contents, which is what lets the "!" rules below re-include files;
# git cannot re-include a file beneath an excluded directory.
docs/*
!docs/figures/
!docs/overview.md
!docs/technical-walkthrough.md
!docs/reproduction-m*.md
!docs/datasets_table.csv
!docs/zenodo_840333_manifest.json

# Data — never committed. Regenerated by scripts/download.py
# Anchored to repo root: an unanchored "data/" also matches tests/data/,
# which holds committed ground-truth fixtures and must never be ignored.
/data/
/results/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Snakemake's own run metadata/lock/log cache -- regenerated every run,
# never something a reader needs to inspect or reproduce anything from.
/.snakemake/

# OS / editor
.DS_Store
.vscode/
.idea/
*:Zone.Identifier
